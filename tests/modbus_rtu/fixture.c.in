// Host fixtures and assertions only. Production poll/types/CRC are extracted by run.py.
#include <stdbool.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#define MODBUS_MAX_ADU_SIZE 15
#define SERIAL_NO_DATA (-1)
#define max(a, b) ((a) > (b) ? (a) : (b))

/* EXTRACTED_DECLARATIONS */

static uint8_t rx_bytes[64];
static unsigned rx_head, rx_tail, now;
static uint32_t rx_timeout, silence_until, silence_timeout;
static bool spin_lock, is_blocking;
static volatile queue_entry_t *tail, *head, *packet;
static volatile modbus_state_t state;
static modbus_exception_t exception_code;
static struct { uint32_t rx_timeout; } modbus;
static uint32_t ticks(void) { return now; }
static struct { uint32_t (*get_elapsed_ticks)(void); } hal = { ticks };
static uint16_t rx_count(void) { return rx_head - rx_tail; }
static uint16_t tx_count(void) { return 0; }
static int32_t read_byte(void) { return rx_tail < rx_head ? rx_bytes[rx_tail++] : SERIAL_NO_DATA; }
static void flush_rx(void) { rx_tail = rx_head; }
static struct {
    uint16_t (*get_tx_buffer_count)(void);
    uint16_t (*get_rx_buffer_count)(void);
    int32_t (*read)(void);
    void (*flush_rx_buffer)(void);
    void (*set_direction)(bool);
} stream = { tx_count, rx_count, read_byte, flush_rx, NULL };
static void tx_message(volatile queue_entry_t *message) { abort(); }

/* EXTRACTED_POLL */

static queue_entry_t request;
static unsigned packets, exceptions, timeouts, last_code, failed;
static uint8_t received[15], received_length;
static void *callback_context;
static void got_packet(modbus_message_t *msg)
{
    packets++;
    callback_context = msg->context;
    received_length = msg->rx_length;
    memcpy(received, msg->adu, received_length);
}
static void got_exception(uint8_t code, void *context) { exceptions++; last_code = code; callback_context = context; }
static void got_timeout(uint8_t code, void *context) { timeouts++; last_code = code; callback_context = context; }
static void reset_request(void)
{
    memset(&request, 0, sizeof(request));
    memset(&stats, 0, sizeof(stats));
    memset(received, 0, sizeof(received));
    packets = exceptions = timeouts = last_code = rx_head = rx_tail = now = 0;
    received_length = 0;
    callback_context = NULL;
    request.async = true;
    request.msg.adu[0] = 1;
    request.msg.adu[1] = 3;
    request.msg.tx_length = 8;
    request.msg.rx_length = 7;
    request.msg.crc_check = false; // Synthetic single-register read with optional normal-response CRC checking.
    request.callbacks.on_rx_packet = got_packet;
    request.callbacks.on_rx_exception = got_exception;
    request.callbacks.on_rx_timeout = got_timeout;
    request.msg.context = (void *)(uintptr_t)42;
    packet = &request;
    tail = head = NULL;
    spin_lock = is_blocking = false;
    state = ModBus_AwaitReply;
    exception_code = ModBus_NoException;
    modbus.rx_timeout = rx_timeout = 10;
    silence_timeout = 2;
    silence_until = 0;
}
static void append(const uint8_t *bytes, unsigned length)
{
    memcpy(rx_bytes + rx_head, bytes, length);
    rx_head += length;
}
static void append_frame(uint8_t *frame, unsigned payload_length)
{
    uint16_t crc = modbus_crc16x(frame, payload_length);
    frame[payload_length] = crc;
    frame[payload_length + 1] = crc >> 8;
    append(frame, payload_length + 2);
}
static void tick(unsigned count)
{
    while(count--) { now++; modbus_poll(NULL); }
}
static void check(const char *name, bool ok)
{
    printf("%s %s\n", ok ? "PASS" : "FAIL", name);
    failed += !ok;
}
static unsigned calls(void) { return packets + exceptions + timeouts; }
static bool async_complete_once(void)
{
    bool ok = calls() == 1 && callback_context == request.msg.context && packet == NULL && state == ModBus_Silent;
    tick(4);
    return ok && calls() == 1 && packet == NULL && state == ModBus_Idle;
}
static bool async_timeout(void)
{
    return !packets && !exceptions && timeouts == 1 && stats.timeouts == 1 &&
           !stats.rx_exceptions && !stats.crc_errors && last_code == 0 && async_complete_once();
}
int main(int argc, char **argv)
{
    reset_request();
    uint8_t normal[7] = {1, 3, 2, 0x12, 0x34};
    append_frame(normal, 5);
    tick(1);
    check("normal seven-byte async response preserves bytes/context", packets == 1 && !exceptions && !timeouts &&
          stats.rx_count == 1 && received_length == 7 && !memcmp(received, normal, 7) && async_complete_once());

    reset_request();
    tick(10);
    check("async silence invokes timeout once", async_timeout());

    reset_request();
    uint8_t exception[5] = {1, 0x83, ModBus_IllegalDataAddress};
    append_frame(exception, 3);
    tick(10);
    if(argc > 1 && strcmp(argv[1], "known-bug") == 0) {
        check("KNOWN BUG: five-byte async exception becomes timeout", async_timeout());
        return failed ? 1 : 0;
    }
    check("five-byte async exception reaches exception callback once", !packets && exceptions == 1 &&
          !timeouts && !stats.timeouts && !stats.crc_errors && last_code == ModBus_IllegalDataAddress &&
          stats.rx_exceptions == 1 && async_complete_once());

    reset_request();
    append(exception, 2);
    tick(3);
    check("fragmented exception waits for rest of frame", !calls() && packet == &request && state == ModBus_AwaitReply);
    append(exception + 2, 2);
    tick(3);
    check("four-byte partial exception still waits", !calls() && packet == &request && state == ModBus_AwaitReply);
    append(exception + 4, 1);
    tick(4);
    check("fragmented exception decoded exactly once", exceptions == 1 && !packets && !timeouts &&
          last_code == ModBus_IllegalDataAddress && stats.rx_exceptions == 1 && !stats.timeouts && async_complete_once());

    for(unsigned variant = 0; variant < 2; variant++) {
        reset_request();
        uint8_t unrelated[5] = {1, 0x83, ModBus_IllegalDataAddress};
        unrelated[variant] = variant == 0 ? 2 : 0x84;
        append_frame(unrelated, 3);
        tick(10);
        check(variant ? "wrong exception function times out" : "wrong exception address times out", async_timeout());
    }

    reset_request();
    uint8_t bad_crc[5];
    memcpy(bad_crc, exception, sizeof(bad_crc));
    bad_crc[4] ^= 1;
    append(bad_crc, sizeof(bad_crc));
    tick(10);
    check("matching exception with bad CRC reports CRC error", exceptions == 1 && !packets && !timeouts &&
          last_code == ModBus_CRCError && stats.crc_errors == 1 && !stats.rx_exceptions &&
          !stats.timeouts && async_complete_once());

    for(unsigned length = 1; length < 5; length++) {
        reset_request();
        append(exception, length);
        tick(10);
        char name[64];
        snprintf(name, sizeof(name), "%u-byte truncated exception times out", length);
        check(name, async_timeout());
    }

    reset_request();
    request.async = false;
    append(exception, sizeof(exception));
    tick(10);
    check("sync exception defers callback to blocking sender", !calls() && packet == &request &&
          state == ModBus_Exception && exception_code == ModBus_IllegalDataAddress &&
          stats.rx_exceptions == 1 && !stats.timeouts && !stats.crc_errors && request.msg.context == (void *)(uintptr_t)42);
    tick(2);
    check("sync exception is not delivered twice by poll", !calls() && state == ModBus_Exception && stats.rx_exceptions == 1);

    reset_request();
    request.async = false;
    tick(10);
    check("sync silence defers timeout to blocking sender", !calls() && packet == &request &&
          state == ModBus_TimeoutException && stats.timeouts == 1 && !stats.rx_exceptions && !stats.crc_errors);

    reset_request();
    request.async = false;
    append(normal, 5); // Normal function 3 prefix and payload, with both CRC bytes missing.
    tick(10);
    bool partial_seen = !stats.no_rx && !calls() && packet == &request &&
                        state == ModBus_TimeoutException && stats.timeouts == 1;
    tick(1); // The TimeoutException handler must preserve the observed partial reply.
    check("sync partial normal reply is not reported as no connection", partial_seen &&
          !stats.no_rx && !calls() && packet == &request && state == ModBus_TimeoutException &&
          stats.timeouts == 1 && !stats.rx_exceptions && !stats.crc_errors);

    reset_request();
    request.msg.crc_check = true;
    append(normal, sizeof(normal));
    tick(1);
    check("CRC-checked normal response remains intact", packets == 1 && !exceptions && !timeouts &&
          !stats.crc_errors && received_length == 7 && !memcmp(received, normal, 7) && async_complete_once());
    return failed ? 1 : 0;
}
